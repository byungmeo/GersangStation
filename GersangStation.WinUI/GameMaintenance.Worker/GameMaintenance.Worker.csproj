<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>GersangStation.GameMaintenance</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Configurations>Debug;Release;Dev</Configurations>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- 메인 앱과 동일하게 구형 Windows의 CET 초기화 오류를 우회합니다 (#188). -->
    <CETCompat>false</CETCompat>
    <PublishTrimmed>false</PublishTrimmed>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="..\GameMaintenance.Contracts\GameMaintenance.Contracts.csproj" /></ItemGroup>
</Project>
