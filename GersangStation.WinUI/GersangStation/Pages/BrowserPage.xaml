<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="GersangStation.Main.WebViewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:GersangStation.Main"
    xmlns:controls="using:GersangStation.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:Core.Models"
    xmlns:service="using:GersangStation.Services"
    d:DataContext="{d:DesignInstance Type=service:WebViewManager}"
    NavigationCacheMode="Required"
    Loaded="BrowserPage_LoginFeedbackLoaded"
    Unloaded="BrowserPage_LoginFeedbackUnloaded"
    mc:Ignorable="d">
    <Page.Resources>
        <Style x:Key="BrowserLoginWarningTipStyle" TargetType="TeachingTip" BasedOn="{StaticResource AppTeachingTipStyle}">
            <Setter Property="Background" Value="{ThemeResource SystemFillColorCautionBackgroundBrush}" />
        </Style>
        <Style x:Key="BrowserLoginFailureTipStyle" TargetType="TeachingTip" BasedOn="{StaticResource AppTeachingTipStyle}">
            <Setter Property="Background" Value="{ThemeResource SystemFillColorCriticalBackgroundBrush}" />
        </Style>
    </Page.Resources>
    <ContentControl
        HorizontalContentAlignment="Stretch"
        VerticalContentAlignment="Stretch"
        IsEnabled="{x:Bind CanUseBrowser, Mode=OneWay}"
        IsTabStop="False">
        <Grid
            x:Name="BrowserChrome"
            Padding="8"
            Background="{ThemeResource ControlFillColorDefaultBrush}"
            BorderBrush="{ThemeResource SurfaceStrokeColorDefault}"
            BorderThickness="0,0,0,1"
            RowSpacing="4">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="8">
                <Grid.Resources>
                    <Style
                        x:Key="BrowserTitleBarButtonStyle"
                        BasedOn="{StaticResource SubtleButtonStyle}"
                        TargetType="Button">
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Width" Value="32" />
                        <Setter Property="Height" Value="32" />
                    </Style>
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel
                    Grid.Column="0"
                    Orientation="Horizontal"
                    Spacing="4">
                    <Button
                        x:Name="Button_WebPreview_Back"
                        Click="Button_WebPreview_Back_Click"
                        IsEnabled="{x:Bind _webviewManager.CanGoBack, Mode=OneWay}"
                        Style="{ThemeResource BrowserTitleBarButtonStyle}">
                        <FontIcon FontSize="18" Glyph="&#xE76B;" />
                    </Button>
                    <Button
                        x:Name="Button_WebPreview_Forward"
                        Click="Button_WebPreview_Forward_Click"
                        IsEnabled="{x:Bind _webviewManager.CanGoForward, Mode=OneWay}"
                        Style="{ThemeResource BrowserTitleBarButtonStyle}">
                        <FontIcon FontSize="18" Glyph="&#xE76C;" />
                    </Button>
                    <Button
                        x:Name="Button_WebPreview_Refresh"
                        Click="Button_WebPreview_Refresh_Click"
                        Style="{ThemeResource BrowserTitleBarButtonStyle}"
                        ToolTipService.ToolTip="새로고침">
                        <FontIcon FontSize="16" Glyph="&#xE72C;" />
                    </Button>
                    <Button
                        x:Name="Button_WebPreview_Home"
                        Click="Button_WebPreview_Home_Click"
                        Style="{ThemeResource BrowserTitleBarButtonStyle}"
                        ToolTipService.ToolTip="거상공홈으로 이동">
                        <FontIcon FontSize="16" Glyph="&#xE80F;" />
                    </Button>
                    <ComboBox
                        x:Name="ComboBox_Account"
                        Width="196"
                        DisplayMemberPath="Nickname"
                        IsEnabled="{x:Bind CanSelectAccount, Mode=OneWay}"
                        ItemsSource="{x:Bind Accounts, Mode=OneWay}"
                        PlaceholderText="미로그인 상태"
                        SelectedItem="{x:Bind SelectedAccount, Mode=TwoWay}"
                        SelectionChanged="ComboBox_Account_SelectionChanged"
                        ToolTipService.ToolTip="로그인 계정 선택 및 로그인 현황" />
                </StackPanel>
                <TextBox
                    x:Name="TextBox_Search"
                    Grid.Column="1"
                    CornerRadius="4"
                    GotFocus="TextBox_Search_GotFocus"
                    KeyDown="TextBox_Search_KeyDown"
                    LostFocus="TextBox_Search_LostFocus"
                    PlaceholderText="주소 또는 검색어 입력" />
                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="4">
                    <Button
                        x:Name="Button_Favorite"
                        Click="Button_Favorite_Click"
                        Style="{ThemeResource BrowserTitleBarButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind FavoriteButtonToolTip, Mode=OneWay}">
                        <FontIcon FontSize="16" Glyph="{x:Bind FavoriteButtonGlyph, Mode=OneWay}" />
                    </Button>
                    <Button
                        x:Name="Button_WebPreview_LaunchExternal"
                        Click="Button_WebPreview_LaunchExternal_Click"
                        Style="{ThemeResource BrowserTitleBarButtonStyle}"
                        ToolTipService.ToolTip="외부 브라우저로 열기">
                        <FontIcon FontSize="16" Glyph="&#xE8A7;" />
                    </Button>
                </StackPanel>
            </Grid>

            <Border
                Grid.Row="1"
                HorizontalAlignment="Stretch"
                Visibility="{x:Bind FavoritesVisibility, Mode=OneWay}">
                <ScrollViewer
                    HorizontalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Enabled"
                    VerticalScrollBarVisibility="Disabled"
                    VerticalScrollMode="Disabled">
                    <ItemsControl ItemsSource="{x:Bind Favorites, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="model:BrowserFavorite">
                                <controls:FavoriteItemView
                                    Loaded="FavoriteView_Loaded"
                                    Unloaded="FavoriteView_Unloaded"
                                    NavigateRequested="FavoriteView_NavigateRequested"
                                    DeleteRequested="FavoriteView_DeleteRequested"
                                    Tag="{x:Bind}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
            <TeachingTip x:Name="BrowserLoginTeachingTip" Target="{x:Bind ComboBox_Account}"
                         Style="{StaticResource BrowserLoginWarningTipStyle}"
                         IsLightDismissEnabled="True" PreferredPlacement="Bottom"
                         Closing="BrowserLoginTeachingTip_Closing" Closed="BrowserLoginTeachingTip_Closed">
                <TeachingTip.Resources>
                    <ResourceDictionary>
                        <ResourceDictionary.ThemeDictionaries>
                            <ResourceDictionary x:Key="Light">
                                <SolidColorBrush x:Key="TeachingTipTransientBackground" Color="{ThemeResource SystemFillColorCautionBackground}" />
                                <SolidColorBrush x:Key="BrowserLoginIconBrush" Color="{ThemeResource SystemFillColorCaution}" />
                            </ResourceDictionary>
                            <ResourceDictionary x:Key="Dark">
                                <SolidColorBrush x:Key="TeachingTipTransientBackground" Color="{ThemeResource SystemFillColorCautionBackground}" />
                                <SolidColorBrush x:Key="BrowserLoginIconBrush" Color="{ThemeResource SystemFillColorCaution}" />
                            </ResourceDictionary>
                            <ResourceDictionary x:Key="HighContrast">
                                <SolidColorBrush x:Key="TeachingTipTransientBackground" Color="{ThemeResource SystemColorWindowColor}" />
                                <SolidColorBrush x:Key="BrowserLoginIconBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                            </ResourceDictionary>
                        </ResourceDictionary.ThemeDictionaries>
                    </ResourceDictionary>
                </TeachingTip.Resources>
                <TeachingTip.IconSource>
                    <FontIconSource Glyph="&#xE7BA;" FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                    Foreground="{ThemeResource BrowserLoginIconBrush}" />
                </TeachingTip.IconSource>
                <StackPanel x:Name="BrowserLoginWarningActions" Margin="32,4,0,4" Spacing="8">
                    <Button x:Name="BrowserLoginAccountSettingsButton" Click="OpenLoginAccountSettingsButton_Click" Content="계정 설정" />
                    <Button x:Name="BrowserPhoneVerificationButton" Click="OpenPhoneVerificationButton_Click" Content="본인 인증 하기" Visibility="Collapsed" />
                </StackPanel>
            </TeachingTip>
            <TeachingTip x:Name="BrowserLoginFailureTeachingTip" Target="{x:Bind ComboBox_Account}"
                         Style="{StaticResource BrowserLoginFailureTipStyle}"
                         IsLightDismissEnabled="True" PreferredPlacement="Bottom"
                         Closing="BrowserLoginTeachingTip_Closing" Closed="BrowserLoginTeachingTip_Closed">
                <TeachingTip.Resources>
                    <ResourceDictionary>
                        <ResourceDictionary.ThemeDictionaries>
                            <ResourceDictionary x:Key="Light">
                                <SolidColorBrush x:Key="TeachingTipTransientBackground" Color="{ThemeResource SystemFillColorCriticalBackground}" />
                                <SolidColorBrush x:Key="BrowserLoginIconBrush" Color="{ThemeResource SystemFillColorCritical}" />
                            </ResourceDictionary>
                            <ResourceDictionary x:Key="Dark">
                                <SolidColorBrush x:Key="TeachingTipTransientBackground" Color="{ThemeResource SystemFillColorCriticalBackground}" />
                                <SolidColorBrush x:Key="BrowserLoginIconBrush" Color="{ThemeResource SystemFillColorCritical}" />
                            </ResourceDictionary>
                            <ResourceDictionary x:Key="HighContrast">
                                <SolidColorBrush x:Key="TeachingTipTransientBackground" Color="{ThemeResource SystemColorWindowColor}" />
                                <SolidColorBrush x:Key="BrowserLoginIconBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                            </ResourceDictionary>
                        </ResourceDictionary.ThemeDictionaries>
                    </ResourceDictionary>
                </TeachingTip.Resources>
                <TeachingTip.IconSource>
                    <FontIconSource Glyph="&#xEA39;" FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                    Foreground="{ThemeResource BrowserLoginIconBrush}" />
                </TeachingTip.IconSource>
                <StackPanel x:Name="BrowserLoginFailureActions" Margin="32,4,0,4" Spacing="8">
                    <Button x:Name="BrowserLoginFailureAccountSettingsButton" Click="OpenLoginAccountSettingsButton_Click" Content="계정 설정" />
                    <Button x:Name="BrowserLoginHelpButton" Click="OpenBrowserLoginHelpButton_Click" Content="해결 방법 보기" />
                    <Button x:Name="BrowserFailurePhoneVerificationButton" Click="OpenPhoneVerificationButton_Click" Content="본인 인증 하기" Visibility="Collapsed" />
                </StackPanel>
            </TeachingTip>
        </Grid>
    </ContentControl>
</Page>
