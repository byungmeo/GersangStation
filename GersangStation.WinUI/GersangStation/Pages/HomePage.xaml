<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="GersangStation.Main.StationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GersangStation.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:GersangStation.Main"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">

    <ScrollViewer>
        <Grid Padding="8,8,16,8" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <controls:HorizontalScrollContainer Grid.Row="0">
                <controls:HorizontalScrollContainer.Source>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <controls:Tile
                            Title="처음 사용하시나요?"
                            Description="사용자 설명서를 참고하세요."
                            Link="https://github.com/byungmeo/GersangStation/wiki/%EA%B1%B0%EC%83%81-%EC%8A%A4%ED%85%8C%EC%9D%B4%EC%85%98-2.0-%EC%82%AC%EC%9A%A9%EC%9E%90-%EC%84%A4%EB%AA%85%EC%84%9C">
                            <controls:Tile.Source>
                                <FontIcon
                                    Margin="0,8,0,0"
                                    FontSize="24"
                                    Foreground="{ThemeResource SystemFillColorAttentionBrush}"
                                    Glyph="&#xE7BE;" />
                            </controls:Tile.Source>
                        </controls:Tile>
                        <controls:Tile
                            Title="도움이 필요하신가요?"
                            Description="자주 물어보는 질문 및 문의 방법을 확인하세요."
                            Link="https://github.com/byungmeo/GersangStation/wiki/Q&amp;A">
                            <controls:Tile.Source>
                                <FontIcon
                                    Margin="0,8,0,0"
                                    FontSize="24"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                    Glyph="&#xE897;" />
                            </controls:Tile.Source>
                        </controls:Tile>
                        <controls:Tile
                            Title="깃허브 저장소"
                            Description="거상 스테이션은 오픈소스 프로젝트입니다."
                            Link="https://github.com/byungmeo/GersangStation">
                            <controls:Tile.Source>
                                <FontIcon
                                    Margin="0,8,0,0"
                                    FontSize="24"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                    Glyph="&#xE943;" />
                            </controls:Tile.Source>
                        </controls:Tile>
                        <controls:Tile
                            Title="후원하기"
                            Description="프로그램 개발자에게 후원하실 수 있습니다."
                            Link="https://github.com/byungmeo/GersangStation/discussions/26">
                            <controls:Tile.Source>
                                <FontIcon
                                    Margin="0,8,0,0"
                                    FontSize="24"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Glyph="&#xEB52;" />
                            </controls:Tile.Source>
                        </controls:Tile>
                    </StackPanel>
                </controls:HorizontalScrollContainer.Source>
            </controls:HorizontalScrollContainer>

            <Grid Grid.Row="1">
                <controls:EventBanner
                    x:Name="EventBanner"
                    HeaderText="{x:Bind EventHeaderText, Mode=OneWay}"
                    PeriodText="{x:Bind CurrentEventPeriodOverlayText, Mode=OneWay}"
                    PeriodVisibility="{x:Bind EventPeriodOverlayVisibility, Mode=OneWay}"
                    RemainingDays="{x:Bind CurrentEventRemainingDays, Mode=OneWay}">
                    <controls:EventBanner.BannerContent>
                        <Viewbox
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Top"
                            Stretch="Uniform"
                            StretchDirection="Both">
                            <FlipView
                                x:Name="FlipView_Event"
                                Width="1920"
                                Height="610"
                                BorderBrush="{ThemeResource CardStrokeColorDefault}"
                                BorderThickness="1"
                                ItemsSource="{x:Bind EventItems, Mode=OneWay}"
                                SelectionChanged="FlipView_Event_SelectionChanged">
                                <FlipView.ItemTemplate>
                                    <DataTemplate x:DataType="local:StationEventThumbnailItem">
                                        <HyperlinkButton
                                            Padding="0"
                                            BorderThickness="0"
                                            Click="EventThumbnail_Click"
                                            Tag="{x:Bind DetailUrl}">
                                            <Image Source="{x:Bind ThumbnailUrl}" Stretch="UniformToFill" />
                                        </HyperlinkButton>
                                    </DataTemplate>
                                </FlipView.ItemTemplate>
                            </FlipView>
                        </Viewbox>
                    </controls:EventBanner.BannerContent>
                </controls:EventBanner>
                <Grid
                    Canvas.ZIndex="1"
                    Background="Transparent"
                    Visibility="{x:Bind local:StationPage.VisibleIf(EventLoad.IsOverlayVisible), Mode=OneWay}">
                    <ProgressRing
                        Width="48"
                        Height="48"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="이벤트 불러오는 중"
                        IsActive="{x:Bind EventLoad.IsLoading, Mode=OneWay}"
                        Visibility="{x:Bind local:StationPage.VisibleIf(EventLoad.IsLoading), Mode=OneWay}" />
                    <Button
                        x:Name="RetryEventsButton"
                        Width="48"
                        Height="48"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="이벤트 다시 불러오기"
                        Click="RetryEvents_Click"
                        FontSize="24"
                        Style="{ThemeResource SubtleButtonStyle}"
                        ToolTipService.ToolTip="이벤트 다시 불러오기"
                        Visibility="{x:Bind local:StationPage.VisibleIf(EventLoad.HasFailed), Mode=OneWay}">
                        <FontIcon FontSize="{x:Bind RetryEventsButton.FontSize, Mode=OneWay}" Glyph="&#xE72C;" />
                    </Button>
                </Grid>
            </Grid>

            <Grid Grid.Row="2" Padding="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="18" Glyph="&#xE789;" />
                        <TextBlock
                            FontSize="18"
                            FontWeight="Bold"
                            Text="게임 공지사항" />
                        <Button
                            x:Name="MoreGameAnnouncementsButton"
                            Margin="0"
                            Padding="0"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="게임 공지사항 전체 보기"
                            Click="HomepageNotice_Click"
                            CornerRadius="18"
                            Style="{ThemeResource SubtleButtonStyle}"
                            Tag="https://www.gersang.co.kr/news/notice.gs?GSbid=1001"
                            ToolTipService.ToolTip="게임 공지사항 전체 보기">
                            <FontIcon FontSize="18" Glyph="&#xECC8;" />
                        </Button>
                    </StackPanel>
                    <Grid Grid.Row="1" MinHeight="160">
                        <StackPanel Spacing="12">
                            <ItemsControl ItemsSource="{x:Bind HomepageNoticeItems, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:StationHomepageNoticeItem">
                                        <HyperlinkButton
                                            Padding="4"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                                            BorderThickness="0,1,0,0"
                                            Click="HomepageNotice_Click"
                                            Tag="{x:Bind Url}">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    MaxLines="1"
                                                    Text="{x:Bind Title}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Text="{x:Bind DateText}" />
                                            </Grid>
                                        </HyperlinkButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="공지사항이 없습니다."
                                Visibility="{x:Bind local:StationPage.VisibleIf(HomepageNoticeLoad.IsEmpty), Mode=OneWay}" />
                        </StackPanel>
                        <Grid
                            Canvas.ZIndex="1"
                            Background="Transparent"
                            Visibility="{x:Bind local:StationPage.VisibleIf(HomepageNoticeLoad.IsOverlayVisible), Mode=OneWay}">
                            <ProgressRing
                                Width="48"
                                Height="48"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="게임 공지사항 불러오는 중"
                                IsActive="{x:Bind HomepageNoticeLoad.IsLoading, Mode=OneWay}"
                                Visibility="{x:Bind local:StationPage.VisibleIf(HomepageNoticeLoad.IsLoading), Mode=OneWay}" />
                            <Button
                                x:Name="RetryHomepageNoticesButton"
                                Width="48"
                                Height="48"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="게임 공지사항 다시 불러오기"
                                Click="RetryHomepageNotices_Click"
                                FontSize="24"
                                Style="{ThemeResource SubtleButtonStyle}"
                                ToolTipService.ToolTip="게임 공지사항 다시 불러오기"
                                Visibility="{x:Bind local:StationPage.VisibleIf(HomepageNoticeLoad.HasFailed), Mode=OneWay}">
                                <FontIcon FontSize="{x:Bind RetryHomepageNoticesButton.FontSize, Mode=OneWay}" Glyph="&#xE72C;" />
                            </Button>
                        </Grid>
                    </Grid>
                </Grid>

                <Border
                    Grid.Column="1"
                    Margin="16,0"
                    BorderBrush="{ThemeResource CardStrokeColorDefault}"
                    BorderThickness="1,0,0,0" />

                <Grid Grid.Column="2" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="18" Glyph="&#xE789;" />
                        <TextBlock
                            FontSize="18"
                            FontWeight="Bold"
                            Text="스테이션 공지사항" />
                    </StackPanel>
                    <Grid Grid.Row="1" MinHeight="160">
                        <StackPanel Spacing="12">
                            <ItemsControl ItemsSource="{x:Bind GersangStationNoticeItems, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:StationHomepageNoticeItem">
                                        <HyperlinkButton
                                            Padding="4"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                                            BorderThickness="0,1,0,0"
                                            Click="GersangStationNotice_Click"
                                            Tag="{x:Bind Url}">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    MaxLines="1"
                                                    Text="{x:Bind Title}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Text="{x:Bind DateText}" />
                                            </Grid>
                                        </HyperlinkButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="공지사항이 없습니다."
                                Visibility="{x:Bind local:StationPage.VisibleIf(GersangStationNoticeLoad.IsEmpty), Mode=OneWay}" />
                        </StackPanel>
                        <Grid
                            Canvas.ZIndex="1"
                            Background="Transparent"
                            Visibility="{x:Bind local:StationPage.VisibleIf(GersangStationNoticeLoad.IsOverlayVisible), Mode=OneWay}">
                            <ProgressRing
                                Width="48"
                                Height="48"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="스테이션 공지사항 불러오는 중"
                                IsActive="{x:Bind GersangStationNoticeLoad.IsLoading, Mode=OneWay}"
                                Visibility="{x:Bind local:StationPage.VisibleIf(GersangStationNoticeLoad.IsLoading), Mode=OneWay}" />
                            <Button
                                x:Name="RetryStationNoticesButton"
                                Width="48"
                                Height="48"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="스테이션 공지사항 다시 불러오기"
                                Click="RetryStationNotices_Click"
                                FontSize="24"
                                Style="{ThemeResource SubtleButtonStyle}"
                                ToolTipService.ToolTip="스테이션 공지사항 다시 불러오기"
                                Visibility="{x:Bind local:StationPage.VisibleIf(GersangStationNoticeLoad.HasFailed), Mode=OneWay}">
                                <FontIcon FontSize="{x:Bind RetryStationNoticesButton.FontSize, Mode=OneWay}" Glyph="&#xE72C;" />
                            </Button>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
