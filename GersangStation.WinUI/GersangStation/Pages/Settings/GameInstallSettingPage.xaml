<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="GersangStation.Main.Setting.GameInstallSettingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GersangStation.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:GersangStation.Main.Setting"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Core.Models"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    NavigationCacheMode="Disabled"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///CommunityToolkit.WinUI.Controls.Segmented/Segmented/Segmented.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <toolkit:Segmented
            x:Name="Segmented_Server"
            Grid.Row="0"
            AutomationProperties.Name="설치할 게임 서버"
            IsEnabled="{x:Bind IsNotBusy, Mode=OneWay}"
            SelectionChanged="Segmented_Server_SelectionChanged"
            SelectionMode="Single"
            Style="{StaticResource DefaultSegmentedStyle}">
            <toolkit:SegmentedItem x:Name="SegmentedItem_Live" Content="본섭">
                <toolkit:SegmentedItem.Icon>
                    <FontIcon FontSize="{x:Bind SegmentedItem_Live.FontSize, Mode=OneWay}" Glyph="{x:Bind local:GameInstallSettingPage.ServerSelectionGlyph(SegmentedItem_Live.IsSelected), Mode=OneWay}" />
                </toolkit:SegmentedItem.Icon>
            </toolkit:SegmentedItem>
            <toolkit:SegmentedItem x:Name="SegmentedItem_Test" Content="테섭">
                <toolkit:SegmentedItem.Icon>
                    <FontIcon FontSize="{x:Bind SegmentedItem_Test.FontSize, Mode=OneWay}" Glyph="{x:Bind local:GameInstallSettingPage.ServerSelectionGlyph(SegmentedItem_Test.IsSelected), Mode=OneWay}" />
                </toolkit:SegmentedItem.Icon>
            </toolkit:SegmentedItem>
            <toolkit:SegmentedItem x:Name="SegmentedItem_RnD" Content="천라섭">
                <toolkit:SegmentedItem.Icon>
                    <FontIcon FontSize="{x:Bind SegmentedItem_RnD.FontSize, Mode=OneWay}" Glyph="{x:Bind local:GameInstallSettingPage.ServerSelectionGlyph(SegmentedItem_RnD.IsSelected), Mode=OneWay}" />
                </toolkit:SegmentedItem.Icon>
            </toolkit:SegmentedItem>
        </toolkit:Segmented>

        <Border
            Grid.Row="0"
            Height="1"
            Margin="0,10,0,0"
            VerticalAlignment="Bottom"
            Background="{ThemeResource ControlStrokeColorDefaultBrush}" />

        <toolkit:SwitchPresenter
            x:Name="InstallContentPresenter"
            Grid.Row="1"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            Value="{x:Bind SelectedGameServer, Mode=OneWay}">
            <toolkit:Case Value="{x:Bind models:GameServer.Korea_Live, Mode=OneTime}">
                <controls:GameInstallPanel
                    x:Name="InstallPanel_Live"
                    AutomationProperties.Name="본섭 설치"
                    CancelRequested="Button_InstallStop_Click"
                    State="{x:Bind}" />
            </toolkit:Case>
            <toolkit:Case Value="{x:Bind models:GameServer.Korea_Test, Mode=OneTime}">
                <controls:GameInstallPanel
                    x:Name="InstallPanel_Test"
                    AutomationProperties.Name="테섭 설치"
                    CancelRequested="Button_InstallStop_Click"
                    State="{x:Bind}" />
            </toolkit:Case>
            <toolkit:Case Value="{x:Bind models:GameServer.Korea_RnD, Mode=OneTime}">
                <controls:GameInstallPanel
                    x:Name="InstallPanel_RnD"
                    AutomationProperties.Name="천라섭 설치"
                    CancelRequested="Button_InstallStop_Click"
                    State="{x:Bind}" />
            </toolkit:Case>
        </toolkit:SwitchPresenter>
    </Grid>
</Page>
