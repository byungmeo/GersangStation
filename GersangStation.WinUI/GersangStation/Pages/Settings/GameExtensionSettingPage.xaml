<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="GersangStation.Main.Setting.GameExtensionSettingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:GersangStation.Main.Setting"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    NavigationCacheMode="Disabled"
    mc:Ignorable="d">
    <ScrollViewer
        HorizontalContentAlignment="Stretch"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        VerticalScrollBarVisibility="Auto">
        <Grid Padding="24" HorizontalAlignment="Stretch">
            <StackPanel
                MaxWidth="896"
                HorizontalAlignment="Stretch"
                Spacing="16">
                <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="부가기능" />
                <toolkit:SettingsExpander x:Name="SettingsExpander_MouseConfinement" Header="마우스 가두기">
                    <toolkit:SettingsExpander.Description>
                        <StackPanel Spacing="4">
                            <TextBlock
                                Text="윈도우 디스플레이 설정이 고배율(125%, 150% 등)인 경우 게임 밖으로 마우스가 벗어나지 않도록 개선합니다."
                                TextWrapping="WrapWholeWords" />
                            <StackPanel
                                x:Name="Panel_ClipMouseAdminWarning"
                                Spacing="4"
                                Visibility="Collapsed">
                                <TextBlock
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Text="이 기능을 사용하려면 관리자 권한이 필요합니다."
                                    TextWrapping="WrapWholeWords" />
                                <HyperlinkButton
                                    Padding="0"
                                    HorizontalAlignment="Left"
                                    Click="HyperlinkButton_ClipMouseAdminHelp_Click"
                                    Content="도움말 보기" />
                            </StackPanel>
                        </StackPanel>
                    </toolkit:SettingsExpander.Description>
                    <ToggleSwitch
                        x:Name="ToggleSwitch_MouseConfinement"
                        AutomationProperties.Name="마우스 가두기"
                        OffContent="비활성화"
                        OnContent="활성화"
                        Toggled="ToggleSwitch_MouseConfinement_Toggled" />
                    <toolkit:SettingsExpander.Items>
                        <toolkit:SettingsCard
                            Description="현재 단축키는 Alt 고정입니다. Alt를 누르는 동안 마우스 가두기가 일시적으로 해제됩니다."
                            Header="마우스 탈출 단축키"
                            IsEnabled="{x:Bind ToggleSwitch_MouseConfinement.IsOn, Mode=OneWay}" />
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>
                <toolkit:SettingsExpander x:Name="SettingsExpander_WindowSwitching" Header="창 전환">
                    <toolkit:SettingsExpander.Description>
                        <StackPanel Spacing="4">
                            <TextBlock
                                Text="게임을 2개 이상 실행한 상태에서 Alt + &#x60;를 누르면 1번, 2번, 3번 실행 버튼 순서대로 게임 창을 위로 순환시킵니다."
                                TextWrapping="WrapWholeWords" />
                            <StackPanel
                                x:Name="Panel_WindowSwitchAdminWarning"
                                Spacing="4"
                                Visibility="Collapsed">
                                <TextBlock
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Text="이 기능을 사용하려면 관리자 권한이 필요합니다."
                                    TextWrapping="WrapWholeWords" />
                                <HyperlinkButton
                                    Padding="0"
                                    HorizontalAlignment="Left"
                                    Click="HyperlinkButton_ClipMouseAdminHelp_Click"
                                    Content="도움말 보기" />
                            </StackPanel>
                        </StackPanel>
                    </toolkit:SettingsExpander.Description>
                    <ToggleSwitch
                        x:Name="ToggleSwitch_WindowSwitching"
                        AutomationProperties.Name="창 전환"
                        OffContent="비활성화"
                        OnContent="활성화"
                        Toggled="ToggleSwitch_WindowSwitching_Toggled" />
                    <toolkit:SettingsExpander.Items>
                        <toolkit:SettingsCard
                            Description="현재 단축키는 Alt + &#x60; 고정입니다. 창 탐색 중에는 마우스 가두기가 잠시 해제되고, 좌클릭으로 창을 결정하면 탐색이 끝납니다."
                            Header="창 전환 단축키"
                            IsEnabled="{x:Bind ToggleSwitch_WindowSwitching.IsOn, Mode=OneWay}" />
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
