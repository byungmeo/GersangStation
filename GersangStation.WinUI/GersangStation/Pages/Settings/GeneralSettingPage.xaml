<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="GersangStation.Main.Setting.GeneralSettingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:GersangStation.Main.Setting"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    d:DataContext="{d:DesignInstance Type=local:GeneralSettingPage}"
    Loaded="GeneralSettingPage_Loaded"
    NavigationCacheMode="Disabled"
    mc:Ignorable="d">
    <ScrollViewer
        HorizontalContentAlignment="Stretch"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        VerticalScrollBarVisibility="Auto">
        <Grid Padding="24" HorizontalAlignment="Stretch">
            <StackPanel
                MaxWidth="896"
                HorizontalAlignment="Stretch"
                Spacing="16">
                <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="일반 설정" />
                <toolkit:SettingsCard
                    HorizontalContentAlignment="Stretch"
                    ContentAlignment="Vertical"
                    Description="앱 타이틀바의 최소화(-) 버튼을 눌렀을 때 동작을 설정합니다."
                    Header="창 최소화 기본 동작">
                    <StackPanel Spacing="8">
                        <RadioButtons
                            AutomationProperties.Name="창 최소화 기본 동작"
                            SelectedIndex="{x:Bind MinimizeBehaviorIndex, Mode=TwoWay}">
                            <x:String>시스템 트레이에 숨기기 (기본값)</x:String>
                            <x:String>작업 표시줄에 숨기기</x:String>
                        </RadioButtons>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="트레이에 숨긴 뒤에는 트레이 아이콘을 더블 클릭해서 다시 열 수 있습니다."
                            TextWrapping="WrapWholeWords" />
                    </StackPanel>
                </toolkit:SettingsCard>
                <toolkit:SettingsCard
                    HorizontalContentAlignment="Stretch"
                    ContentAlignment="Vertical"
                    Description="앱 타이틀바의 닫기(X) 버튼을 눌렀을 때 동작을 설정합니다."
                    Header="창 닫기 기본 동작">
                    <StackPanel Spacing="8">
                        <RadioButtons
                            AutomationProperties.Name="창 닫기 기본 동작"
                            SelectedIndex="{x:Bind CloseBehaviorIndex, Mode=TwoWay}">
                            <x:String>앱 종료(기본값)</x:String>
                            <x:String>시스템 트레이에 숨기기</x:String>
                        </RadioButtons>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="트레이에 숨길 경우 트레이 아이콘을 우클릭 한 뒤 종료 버튼을 눌러 종료할 수 있습니다."
                            TextWrapping="WrapWholeWords" />
                    </StackPanel>
                </toolkit:SettingsCard>
                <toolkit:SettingsCard Header="윈도우 시작 자동 실행">
                    <toolkit:SettingsCard.Description>
                        <StackPanel Spacing="4">
                            <TextBlock
                                Text="Windows에 로그인할 때 프로그램을 자동으로 실행합니다. Windows 시작 앱 설정에서도 변경할 수 있습니다."
                                TextWrapping="WrapWholeWords" />
                            <TextBlock
                                Text="{x:Bind StartupRegistrationMessage, Mode=OneWay}"
                                TextWrapping="WrapWholeWords"
                                Visibility="{x:Bind StartupRegistrationMessageVisibility, Mode=OneWay}" />
                        </StackPanel>
                    </toolkit:SettingsCard.Description>
                    <ToggleSwitch
                        x:Name="ToggleSwitch_StartupRegistration"
                        AutomationProperties.Name="윈도우 시작 시 프로그램 자동 실행"
                        IsEnabled="False"
                        OffContent="해제"
                        OnContent="등록"
                        Toggled="ToggleSwitch_StartupRegistration_Toggled" />
                </toolkit:SettingsCard>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
