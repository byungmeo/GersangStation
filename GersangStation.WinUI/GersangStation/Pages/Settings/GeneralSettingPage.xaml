<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="GersangStation.Main.Setting.GeneralSettingPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="24,24,24,40" RowSpacing="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel Spacing="8">
            <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="일반 설정" />
            <SelectorBar x:Name="GeneralSelector" SelectionChanged="GeneralSelector_SelectionChanged">
                <SelectorBarItem Text="동작" />
                <SelectorBarItem Text="실행" />
            </SelectorBar>
        </StackPanel>
        <Frame x:Name="ContentFrame" Grid.Row="1" IsNavigationStackEnabled="False" />
    </Grid>
</Page>
