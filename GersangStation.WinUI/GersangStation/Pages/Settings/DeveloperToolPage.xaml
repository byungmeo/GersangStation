<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="GersangStation.Main.Setting.DeveloperToolPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:GersangStation.Main.Setting"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:Core.Models"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    NavigationCacheMode="Disabled"
    mc:Ignorable="d">
    <ScrollViewer
        HorizontalContentAlignment="Stretch"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        VerticalScrollBarVisibility="Auto">
        <Grid Padding="24" HorizontalAlignment="Stretch">
            <TeachingTip x:Name="DowngradeResultTip" Target="{x:Bind Button_Downgrade}"
                         IsLightDismissEnabled="True" PreferredPlacement="Bottom"
                         Closing="DowngradeResultTip_Closing" Closed="DowngradeResultTip_Closed" />
            <StackPanel
                MaxWidth="896"
                HorizontalAlignment="Stretch"
                Spacing="16">
                <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="개발자 도구" />
                <toolkit:SettingsCard
                    HorizontalContentAlignment="Stretch"
                    ContentAlignment="Vertical"
                    Description="선택한 서버의 메인 클라이언트 Online\vsn.dat 버전을 직접 낮춰 패치 흐름을 테스트합니다."
                    Header="클라이언트 버전 다운그레이드">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox
                                x:Name="ComboBox_Server"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.Name="다운그레이드할 서버"
                                DisplayMemberPath="DisplayName"
                                Header="서버"
                                ItemsSource="{x:Bind model:GameServerHelper.ServerOptions, Mode=OneTime}"
                                SelectedIndex="0"
                                SelectedValuePath="Server" />
                            <TextBox
                                x:Name="TextBox_TargetDowngradeVersion"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                Header="목표 버전"
                                InputScope="Number"
                                PlaceholderText="예) 34000" />
                        </Grid>
                        <Button
                            x:Name="Button_Downgrade"
                            HorizontalAlignment="Left"
                            Click="Button_Downgrade_Click"
                            Content="다운그레이드"
                            Style="{ThemeResource AccentButtonStyle}" />
                    </StackPanel>
                </toolkit:SettingsCard>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
