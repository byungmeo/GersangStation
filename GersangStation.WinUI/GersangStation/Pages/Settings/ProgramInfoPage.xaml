<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="GersangStation.Main.Setting.ProgramInfoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:GersangStation.Main.Setting"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=local:ProgramInfoPage}"
    NavigationCacheMode="Disabled"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24,24,24,40" Spacing="20">
            <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="{x:Bind AppDisplayName, Mode=OneTime}" />

            <Border
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <StackPanel Spacing="12">
                    <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="프로그램 기본 정보" />
                    <Grid ColumnSpacing="16" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="프로그램명" />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="1"
                            Text="{x:Bind AppDisplayName, Mode=OneTime}" />

                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Text="버전" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            Text="{x:Bind AppVersion, Mode=OneTime}" />

                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="0"
                            Text="배포자" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="1"
                            Text="{x:Bind PublisherDisplayName, Mode=OneTime}" />

                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="0"
                            Text="설명" />
                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="1"
                            Text="{x:Bind AppDescription, Mode=OneTime}"
                            TextWrapping="WrapWholeWords" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <StackPanel Spacing="12">
                    <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="개인정보처리방침" />
                    <TextBlock Text="비밀번호는 Windows 자격 증명 관리자를 통해 로컬에 저장되며, 운영체제의 보안 메커니즘에 의해 보호됩니다." TextWrapping="WrapWholeWords" />
                    <TextBlock Text="계정 정보는 로컬 저장을 기본으로 하며, 개발자 서버 또는 제3자에게 별도로 제공 및 저장하지 않습니다." TextWrapping="WrapWholeWords" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="자동 로그인을 위해 아이디와 비밀번호가 거상 공식 홈페이지로 전송될 수 있습니다."
                        TextWrapping="WrapWholeWords" />
                    <HyperlinkButton
                        Click="LinkButton_Click"
                        Content="개인정보처리방침 보기"
                        Tag="{x:Bind PrivacyPolicyUri, Mode=OneTime}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
