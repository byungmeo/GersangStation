<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="GersangStation.Main.Setting.ProgramInfoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:GersangStation.Main.Setting"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    d:DataContext="{d:DesignInstance Type=local:ProgramInfoPage}"
    NavigationCacheMode="Disabled"
    mc:Ignorable="d">

    <ScrollViewer
        HorizontalContentAlignment="Stretch"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        VerticalScrollBarVisibility="Auto">
        <Grid Padding="24" HorizontalAlignment="Stretch">
            <StackPanel
                MaxWidth="896"
                HorizontalAlignment="Stretch"
                Spacing="16">
                <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="프로그램 정보" />

                <toolkit:SettingsExpander
                    AutomationProperties.AutomationId="ProgramBasicInfoExpander"
                    Description="© 2026 Byungmeo. All rights reserved."
                    Header="{x:Bind AppDisplayName, Mode=OneTime}"
                    IsExpanded="True">
                    <toolkit:SettingsExpander.HeaderIcon>
                        <BitmapIcon ShowAsMonochrome="False" UriSource="/Assets/Icons/StoreLogo.png" />
                    </toolkit:SettingsExpander.HeaderIcon>
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind AppVersion}" />
                    <toolkit:SettingsExpander.Items>
                        <toolkit:SettingsCard
                            HorizontalContentAlignment="Stretch"
                            ContentAlignment="Vertical"
                            Header="오픈소스 라이선스 고지">
                            <toolkit:SettingsCard.Resources>
                                <Style BasedOn="{StaticResource BodyTextBlockStyle}" TargetType="TextBlock">
                                    <Setter Property="Margin" Value="12,0" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="TextWrapping" Value="WrapWholeWords" />
                                </Style>
                            </toolkit:SettingsCard.Resources>
                            <StackPanel Orientation="Vertical" Spacing="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <HyperlinkButton Content="Windows App SDK" NavigateUri="https://aka.ms/windowsappsdk" />
                                    <AppBarSeparator Grid.Column="1" />
                                    <TextBlock Grid.Column="2" Text="Copyright (c) Microsoft Corporation." />
                                    <AppBarSeparator Grid.Column="3" />
                                    <HyperlinkButton Grid.Column="4" Content="MIT License" NavigateUri="https://github.com/microsoft/WindowsAppSDK/blob/main/LICENSE" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <HyperlinkButton Content="Windows Community Toolkit" NavigateUri="https://github.com/CommunityToolkit/dotnet" />
                                    <AppBarSeparator Grid.Column="1" />
                                    <TextBlock Grid.Column="2" Text="Copyright © .NET Foundation and Contributors" />
                                    <AppBarSeparator Grid.Column="3" />
                                    <HyperlinkButton Grid.Column="4" Content="MIT License" NavigateUri="https://github.com/CommunityToolkit/dotnet/blob/main/License.md" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <HyperlinkButton Content="7-Zip (7za.exe)" NavigateUri="https://www.7-zip.org/" />
                                    <AppBarSeparator Grid.Column="1" />
                                    <TextBlock Grid.Column="2" Text="7-Zip Copyright (C) 1999-2025 Igor Pavlov." />
                                    <AppBarSeparator Grid.Column="3" />
                                    <HyperlinkButton Grid.Column="4" Content="GNU LGPL" NavigateUri="https://www.7-zip.org/license.txt" />
                                </Grid>
                            </StackPanel>
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard
                            HorizontalContentAlignment="Left"
                            ContentAlignment="Vertical"
                            Header="개인정보처리방침">
                            <HyperlinkButton
                                AutomationProperties.AutomationId="OpenPrivacyPolicyButton"
                                Click="LinkButton_Click"
                                Content="개인정보처리방침 보기"
                                Tag="{x:Bind PrivacyPolicyUri, Mode=OneTime}" />
                        </toolkit:SettingsCard>
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>
                <toolkit:SettingsCard
                    Description="디버깅이나 테스트용 기능이 필요할 때만 개발자 모드를 켜세요."
                    Header="개발자 모드">
                    <ToggleSwitch
                        x:Name="ToggleSwitch_DeveloperTool"
                        AutomationProperties.Name="개발자 모드"
                        OffContent="비활성화"
                        OnContent="활성화"
                        Toggled="ToggleSwitch_DeveloperTool_Toggled" />
                </toolkit:SettingsCard>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
