<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="GersangStation.Main.Setting.GamePatchSettingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:drawer="using:SideDrawer.Controls"
    xmlns:local="using:GersangStation.Main.Setting"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:Core.Models"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    d:DataContext="{d:DesignInstance Type=local:GamePatchSettingPage}"
    NavigationCacheMode="Disabled"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///CommunityToolkit.WinUI.Controls.Segmented/Segmented/Segmented.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid x:Name="PatchPageRoot">
        <Grid Padding="24" HorizontalAlignment="Stretch">
            <Grid
                MaxWidth="896"
                HorizontalAlignment="Stretch"
                RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="게임 패치" />

                <toolkit:Segmented
                    x:Name="Segmented_Server"
                    Grid.Row="1"
                    AutomationProperties.Name="패치할 게임 서버"
                    IsEnabled="{x:Bind IsNotBusy, Mode=OneWay}"
                    SelectionChanged="Segmented_Server_SelectionChanged"
                    SelectionMode="Single"
                    Style="{StaticResource DefaultSegmentedStyle}">
                    <toolkit:SegmentedItem
                        x:Name="SegmentedItem_Live"
                        Content="본섭"
                        Tag="{x:Bind model:GameServer.Korea_Live}">
                        <toolkit:SegmentedItem.Icon>
                            <FontIcon FontSize="{x:Bind SegmentedItem_Live.FontSize, Mode=OneWay}" Glyph="{x:Bind local:GamePatchSettingPage.ServerSelectionGlyph(SegmentedItem_Live.IsSelected), Mode=OneWay}" />
                        </toolkit:SegmentedItem.Icon>
                    </toolkit:SegmentedItem>
                    <toolkit:SegmentedItem
                        x:Name="SegmentedItem_Test"
                        Content="테섭"
                        Tag="{x:Bind model:GameServer.Korea_Test}">
                        <toolkit:SegmentedItem.Icon>
                            <FontIcon FontSize="{x:Bind SegmentedItem_Test.FontSize, Mode=OneWay}" Glyph="{x:Bind local:GamePatchSettingPage.ServerSelectionGlyph(SegmentedItem_Test.IsSelected), Mode=OneWay}" />
                        </toolkit:SegmentedItem.Icon>
                    </toolkit:SegmentedItem>
                    <toolkit:SegmentedItem
                        x:Name="SegmentedItem_RnD"
                        Content="천라섭"
                        Tag="{x:Bind model:GameServer.Korea_RnD}">
                        <toolkit:SegmentedItem.Icon>
                            <FontIcon FontSize="{x:Bind SegmentedItem_RnD.FontSize, Mode=OneWay}" Glyph="{x:Bind local:GamePatchSettingPage.ServerSelectionGlyph(SegmentedItem_RnD.IsSelected), Mode=OneWay}" />
                        </toolkit:SegmentedItem.Icon>
                    </toolkit:SegmentedItem>
                </toolkit:Segmented>

                <ScrollViewer
                    Grid.Row="2"
                    HorizontalContentAlignment="Stretch"
                    HorizontalScrollBarVisibility="Disabled"
                    HorizontalScrollMode="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    VerticalScrollMode="Auto">
                    <Grid RowSpacing="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <toolkit:SettingsExpander
                            x:Name="SettingsExpander_Patch"
                            HorizontalContentAlignment="Stretch"
                            Header="{x:Bind PatchStatusHeader, Mode=OneWay}"
                            IsExpanded="True">
                            <toolkit:SettingsExpander.Description>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{x:Bind PatchStatusDescription, Mode=OneWay}" TextWrapping="WrapWholeWords" />
                                    <HyperlinkButton
                                        x:Name="HyperlinkButton_DeprecatedVersionInfo"
                                        Padding="0"
                                        HorizontalAlignment="Left"
                                        Click="HyperlinkButton_DeprecatedVersionInfo_Click"
                                        Content="참고 링크"
                                        Visibility="{x:Bind PatchStatusLinkVisibility, Mode=OneWay}" />
                                </StackPanel>
                            </toolkit:SettingsExpander.Description>
                            <toolkit:SettingsExpander.HeaderIcon>
                                <FontIcon FontSize="{x:Bind SettingsExpander_Patch.FontSize, Mode=OneWay}" Glyph="&#xE896;" />
                            </toolkit:SettingsExpander.HeaderIcon>
                            <StackPanel
                                HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                Spacing="8">
                                <Button
                                    x:Name="Button_PatchStart"
                                    VerticalAlignment="Center"
                                    Click="Button_PatchStart_Click"
                                    Content="패치"
                                    IsEnabled="{x:Bind IsPatchStartEnabled, Mode=OneWay}"
                                    Style="{ThemeResource AccentButtonStyle}" />
                                <Button
                                    x:Name="Button_Refresh"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="패치 버전 정보 새로고침"
                                    Click="Button_Refresh_Click"
                                    IsEnabled="{x:Bind IsNotBusy, Mode=OneWay}"
                                    Style="{ThemeResource AlternateCloseButtonStyle}">
                                    <Button.Content>
                                        <FontIcon FontSize="{x:Bind Button_Refresh.FontSize, Mode=OneWay}" Glyph="&#xE895;" />
                                    </Button.Content>
                                </Button>
                            </StackPanel>
                            <toolkit:SettingsExpander.Items>
                                <toolkit:SettingsCard HorizontalContentAlignment="Stretch" ContentAlignment="Vertical">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox
                                            x:Name="ComboBox_CurrentVersion"
                                            Grid.Column="0"
                                            HorizontalAlignment="Stretch"
                                            AutomationProperties.Name="현재 버전"
                                            DisplayMemberPath="Display"
                                            Header="현재 버전"
                                            IsEnabled="{x:Bind IsNotBusy, Mode=OneWay}"
                                            ItemsSource="{x:Bind Versions}"
                                            PlaceholderText="v00000   0000-00-00"
                                            SelectedItem="{x:Bind SelectedVersionItem, Mode=TwoWay}"
                                            SelectionChanged="ComboBox_CurrentVersion_SelectionChanged" />
                                        <FontIcon
                                            Grid.Column="1"
                                            Margin="0,0,0,8"
                                            VerticalAlignment="Bottom"
                                            FontSize="{x:Bind ComboBox_CurrentVersion.FontSize, Mode=OneWay}"
                                            Glyph="&#xEB9D;" />
                                        <TextBox
                                            x:Name="TextBox_LatestVersion"
                                            Grid.Column="2"
                                            HorizontalAlignment="Stretch"
                                            AutomationProperties.Name="최신 버전"
                                            Background="{ThemeResource TextBoxDisabledBackgroundThemeBrush}"
                                            Header="최신 버전"
                                            IsEnabled="{x:Bind IsNotBusy, Mode=OneWay}"
                                            IsReadOnly="True"
                                            PlaceholderText="v00000   0000-00-00"
                                            Text="{x:Bind DisplayLatestVersion, Mode=OneWay}" />
                                    </Grid>
                                </toolkit:SettingsCard>
                                <toolkit:SettingsCard ContentAlignment="Left">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <CheckBox
                                            Grid.Row="0"
                                            AutomationProperties.Name="패치 완료 후 임시 파일 정리"
                                            Content="(권장) 패치 완료 후 임시 파일 정리"
                                            IsChecked="{x:Bind ShouldDeleteTemp, Mode=TwoWay}"
                                            IsEnabled="{x:Bind IsNotBusy, Mode=OneWay}" />
                                        <TextBlock
                                            Grid.Row="1"
                                            FontSize="12"
                                            IsTextSelectionEnabled="True"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Text="{x:Bind TempPath, Mode=OneWay}"
                                            TextWrapping="WrapWholeWords" />
                                    </Grid>
                                </toolkit:SettingsCard>
                                <toolkit:SettingsCard Header="패치 내역">
                                    <Button
                                        x:Name="Button_ViewPatchReadme"
                                        Click="Button_ViewPatchReadme_Click"
                                        Content="패치 내역 확인"
                                        IsEnabled="{x:Bind CanOpenPatchReadme, Mode=OneWay}" />
                                </toolkit:SettingsCard>
                            </toolkit:SettingsExpander.Items>
                        </toolkit:SettingsExpander>

                        <!--#region Progress Row-->
                        <!--  진행 막대/상태 문구의 열 너비를 공유하고 취소 버튼은 첫 행에만 배치하므로 2×2 Grid를 유지합니다.  -->
                        <Grid
                            Grid.Row="1"
                            HorizontalAlignment="Stretch"
                            RowSpacing="8"
                            Visibility="{x:Bind PatchProgressVisibility, Mode=OneWay}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ProgressBar
                                Grid.Row="0"
                                Grid.Column="0"
                                Height="8"
                                HorizontalAlignment="Stretch"
                                Foreground="{x:Bind PatchProgressForeground, Mode=OneWay}"
                                Maximum="{x:Bind ProgressMaximum, Mode=OneWay}"
                                Value="{x:Bind ProgressValue, Mode=OneWay}" />

                            <Button
                                x:Name="Button_PatchStop"
                                Grid.Row="0"
                                Grid.Column="1"
                                Click="Button_PatchStop_Click"
                                IsEnabled="{x:Bind IsDownloading, Mode=OneWay}"
                                Style="{ThemeResource AlternateCloseButtonStyle}"
                                Visibility="{x:Bind PatchCancelVisibility, Mode=OneWay}">
                                <Button.Content>
                                    <FontIcon Glyph="&#xE711;" />
                                </Button.Content>
                            </Button>

                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="0"
                                HorizontalAlignment="Center"
                                Text="{x:Bind ProgressText, Mode=OneWay}"
                                TextAlignment="Center"
                                TextWrapping="WrapWholeWords" />
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!--#region 로딩 오버레이-->
        <Grid
            x:Name="LoadingOverlay"
            Background="{ThemeResource SmokeFillColorDefaultBrush}"
            Visibility="{x:Bind LoadingOverlayVisibility, Mode=OneWay}">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12">
                <ProgressRing
                    Width="86"
                    Height="86"
                    IsActive="{x:Bind IsLoadingPatchInfo, Mode=OneWay}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="28"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    Text="패치 버전 정보를 불러오는 중..." />
            </StackPanel>
        </Grid>
        <!--#endregion 로딩 오버레이-->

        <drawer:Drawer
            x:Name="PatchReadmeDrawer"
            AutomationProperties.AutomationId="PatchReadmeDrawer"
            AutomationProperties.Name="{x:Bind PatchReadmeTitle, Mode=OneWay}"
            InteractionFailed="PatchReadmeDrawer_InteractionFailed"
            Modal="True"
            PanelLength="720"
            Placement="Right">
            <Grid RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{ThemeResource TitleTextBlockStyle}"
                        Text="{x:Bind PatchReadmeTitle, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <Button
                        Grid.Column="1"
                        Click="Button_ClosePatchReadme_Click"
                        Content="닫기" />
                </Grid>
                <ScrollViewer
                    x:Name="ScrollViewer_PatchReadme"
                    Grid.Row="1"
                    HorizontalContentAlignment="Stretch"
                    HorizontalScrollBarVisibility="Disabled"
                    HorizontalScrollMode="Disabled"
                    Loaded="ScrollViewer_PatchReadme_Loaded"
                    Unloaded="ScrollViewer_PatchReadme_Unloaded"
                    VerticalScrollBarVisibility="Auto"
                    ViewChanged="ScrollViewer_PatchReadme_ViewChanged">
                    <RichTextBlock
                        x:Name="RichTextBlock_PatchReadme"
                        Padding="10,10,10,10"
                        HorizontalAlignment="Stretch"
                        IsTextSelectionEnabled="True"
                        TextAlignment="Justify"
                        TextWrapping="Wrap" />
                </ScrollViewer>
            </Grid>
        </drawer:Drawer>

        <Border
            x:Name="PatchTeachingTipAnchor"
            Width="1"
            Height="1"
            Margin="0,0,0,20"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            AutomationProperties.AccessibilityView="Raw"
            IsHitTestVisible="False" />

        <TeachingTip
            x:Name="TeachingTip_PatchResult"
            ActionButtonClick="TeachingTip_PatchResult_ActionButtonClick"
            CloseButtonContent="닫기"
            IsLightDismissEnabled="True"
            PlacementMargin="0"
            PreferredPlacement="Top"
            TailVisibility="Collapsed"
            Target="{x:Bind PatchTeachingTipAnchor}" />
    </Grid>
</Page>
