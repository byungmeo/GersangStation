<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="GersangStation.Main.Setting.AccountSettingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:drawer="using:SideDrawer.Controls"
    xmlns:local="using:GersangStation.Main.Setting"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Core.Models"
    d:DataContext="{d:DesignInstance Type=local:AccountSettingPage}"
    NavigationCacheMode="Disabled"
    mc:Ignorable="d">

    <Page.Resources>
        <CollectionViewSource x:Name="AccountsCVS" IsSourceGrouped="True" />
        <DataTemplate x:Key="AccountListViewTemplate" x:DataType="models:Account">
            <StackPanel Margin="12,6" Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="아이디:" />
                    <TextBlock x:Phase="1" Style="{ThemeResource BaseTextBlockStyle}" Text="{x:Bind Id}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="별명:" />
                    <TextBlock x:Phase="2" Style="{ThemeResource BodyTextBlockStyle}" Text="{x:Bind DisplayNickname}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid x:Name="AccountPageRoot">
        <Grid Margin="12" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <RadioButtons
                    HorizontalAlignment="Left"
                    AutomationProperties.AutomationId="AccountListDisplayMode"
                    IsEnabled="{x:Bind AccountManagementEnabled, Mode=OneWay}"
                    MaxColumns="2"
                    SelectedIndex="{x:Bind AccountListDisplayModeIndex, Mode=TwoWay}">
                    <x:String>그룹으로 보기</x:String>
                    <x:String>순서대로 보기</x:String>
                </RadioButtons>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                    <Button
                        x:Name="Button_Add"
                        AutomationProperties.AutomationId="AddAccount"
                        Click="Button_Add_Click"
                        Content="추가"
                        IsEnabled="{x:Bind AccountManagementEnabled, Mode=OneWay}" />
                    <Button
                        x:Name="Button_Edit"
                        AutomationProperties.AutomationId="EditAccount"
                        Click="Button_Edit_Click"
                        Content="수정"
                        IsEnabled="{x:Bind CanEditSelectedAccount, Mode=OneWay}" />
                    <Button
                        x:Name="Button_Delete"
                        AutomationProperties.AutomationId="DeleteAccount"
                        Click="Button_Delete_Click"
                        Content="삭제"
                        IsEnabled="{x:Bind CanDeleteSelectedAccount, Mode=OneWay}" />
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1">
                <ListView
                    x:Name="AccountListView"
                    AutomationProperties.AutomationId="GroupedAccountList"
                    Background="Transparent"
                    ContextRequested="AccountList_ContextRequested"
                    DoubleTapped="AccountList_DoubleTapped"
                    IsEnabled="{x:Bind AccountManagementEnabled, Mode=OneWay}"
                    ItemTemplate="{StaticResource AccountListViewTemplate}"
                    ItemsSource="{x:Bind AccountsCVS.View, Mode=OneWay}"
                    SelectionChanged="AccountListView_SelectionChanged"
                    SelectionMode="Multiple"
                    Visibility="{x:Bind GroupedListVisibility, Mode=OneWay}">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel AreStickyGroupHeadersEnabled="True" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate x:DataType="models:AccountGroupInfoList">
                                    <Border AutomationProperties.AccessibilityView="Raw">
                                        <TextBlock
                                            AutomationProperties.AccessibilityView="Raw"
                                            Style="{ThemeResource TitleTextBlockStyle}"
                                            Text="{x:Bind Key}" />
                                    </Border>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListView.GroupStyle>
                </ListView>
                <ListView
                    x:Name="OrderedAccountListView"
                    AllowDrop="True"
                    AutomationProperties.AutomationId="OrderedAccountList"
                    Background="Transparent"
                    CanDragItems="True"
                    CanReorderItems="True"
                    ContextRequested="AccountList_ContextRequested"
                    DoubleTapped="AccountList_DoubleTapped"
                    DragItemsCompleted="OrderedAccountListView_DragItemsCompleted"
                    IsEnabled="{x:Bind AccountManagementEnabled, Mode=OneWay}"
                    ItemTemplate="{StaticResource AccountListViewTemplate}"
                    ItemsSource="{x:Bind OrderedAccounts, Mode=OneWay}"
                    SelectionChanged="OrderedAccountListView_SelectionChanged"
                    SelectionMode="Multiple"
                    Visibility="{x:Bind OrderedListVisibility, Mode=OneWay}" />
            </Grid>
        </Grid>

        <drawer:Drawer
            x:Name="AccountEditorDrawer"
            AutomationProperties.AutomationId="AccountEditorDrawer"
            AutomationProperties.Name="{x:Bind EditorTitle, Mode=OneWay}"
            Closed="AccountEditorDrawer_Closed"
            Closing="AccountEditorDrawer_Closing"
            InteractionFailed="AccountEditorDrawer_InteractionFailed"
            Modal="True"
            Opened="AccountEditorDrawer_Opened"
            PanelLength="480"
            Placement="Right">
            <Grid RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="{x:Bind EditorTitle, Mode=OneWay}" />
                <ScrollViewer
                    Grid.Row="1"
                    HorizontalScrollBarVisibility="Disabled"
                    HorizontalScrollMode="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    VerticalScrollMode="Auto">
                    <ContentControl
                        HorizontalContentAlignment="Stretch"
                        IsEnabled="{x:Bind EditorInputsEnabled, Mode=OneWay}"
                        IsTabStop="False">
                        <StackPanel Spacing="12">
                            <TextBox
                                x:Name="TextBox_Id"
                                AutomationProperties.AutomationId="AccountEditorId"
                                Header="아이디"
                                KeyDown="EditorInput_KeyDown"
                                PlaceholderText="게임 아이디"
                                TabIndex="0"
                                Text="{x:Bind Editor.Id, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <StackPanel Spacing="8">
                                <CheckBox
                                    x:Name="CheckBox_ChangePassword"
                                    AutomationProperties.AutomationId="AccountEditorChangePassword"
                                    Click="CheckBox_ChangePassword_Click"
                                    Content="패스워드도 변경"
                                    IsChecked="{x:Bind Editor.IsChangingPassword, Mode=OneWay}"
                                    Visibility="{x:Bind ChangePasswordToggleVisibility, Mode=OneWay}" />
                                <PasswordBox
                                    x:Name="PasswordBox_Pwd"
                                    AutomationProperties.AutomationId="AccountEditorPassword"
                                    Header="{x:Bind PasswordBoxHeader, Mode=OneWay}"
                                    KeyDown="EditorInput_KeyDown"
                                    PasswordChanged="PasswordBox_Pwd_PasswordChanged"
                                    PlaceholderText="{x:Bind PasswordPlaceholderText, Mode=OneWay}"
                                    TabIndex="1"
                                    Visibility="{x:Bind PasswordBoxVisibility, Mode=OneWay}" />
                            </StackPanel>
                            <TextBox
                                x:Name="TextBox_Nickname"
                                AutomationProperties.AutomationId="AccountEditorNickname"
                                Header="(선택) 닉네임"
                                KeyDown="EditorInput_KeyDown"
                                PlaceholderText="예시) 상재, 장사, 생시, etc..."
                                TabIndex="2"
                                Text="{x:Bind Editor.Nickname, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox
                                x:Name="TextBox_GroupName"
                                AutomationProperties.AutomationId="AccountEditorGroupName"
                                Header="(선택) 그룹 이름"
                                KeyDown="EditorInput_KeyDown"
                                PlaceholderText="예시) 나, 동생, 1, 2, 3, etc..."
                                TabIndex="3"
                                Text="{x:Bind Editor.GroupName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <RichTextBlock FontStyle="Italic">
                                <Paragraph>본 프로그램은 비밀번호를 Windows 자격 증명 관리자를 통해 로컬에 저장하며, 운영체제의 보안 메커니즘에 의해 보호됩니다.</Paragraph>
                                <Paragraph>또한, 계정 정보를 로컬을 제외한 개발자 서버 또는 제3자에게 별도로 제공 및 저장하지 않습니다.</Paragraph>
                                <Paragraph>예외로 자동 로그인을 위해 아이디 및 비밀번호가 거상 공식 홈페이지를 통해 전송될 수 있습니다.</Paragraph>
                                <Paragraph>
                                    <Hyperlink Click="PrivacyPolicyHyperlink_Click">개인정보취급방침</Hyperlink>
                                    을 통해 자세한 정보를 확인하실 수 있습니다.
                                </Paragraph>
                            </RichTextBlock>
                        </StackPanel>
                    </ContentControl>
                </ScrollViewer>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                    <Button
                        x:Name="Button_Save"
                        AutomationProperties.AutomationId="SaveAccount"
                        Click="Button_Save_Click"
                        Content="{x:Bind SaveButtonText, Mode=OneWay}"
                        IsEnabled="{x:Bind CanSave, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}"
                        TabIndex="4" />
                    <Button
                        x:Name="Button_Reset"
                        AutomationProperties.AutomationId="ResetAccountEditor"
                        Click="Button_Reset_Click"
                        Content="입력 초기화"
                        IsEnabled="{x:Bind EditorInputsEnabled, Mode=OneWay}"
                        Visibility="{x:Bind ResetButtonVisibility, Mode=OneWay}" />
                    <Button
                        x:Name="Button_CancelEdit"
                        AutomationProperties.AutomationId="CancelAccountEditor"
                        Click="Button_CancelEdit_Click"
                        Content="취소"
                        IsEnabled="{x:Bind EditorInputsEnabled, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </drawer:Drawer>
    </Grid>
</Page>
