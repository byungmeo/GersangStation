<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="GersangStation.Main.Setting.AccountSettingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:drawer="using:SideDrawer.Controls"
    xmlns:local="using:GersangStation.Main.Setting"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Core.Models"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    d:DataContext="{d:DesignInstance Type=local:AccountSettingPage}"
    NavigationCacheMode="Disabled"
    mc:Ignorable="d">

    <Page.Resources>
        <CollectionViewSource x:Name="AccountsCVS" IsSourceGrouped="True" />
        <Style x:Key="AccountItemContainerStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="AccountGroupHeaderContainerStyle" TargetType="ListViewHeaderItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style
            x:Key="AccountItemActionButtonStyle"
            BasedOn="{StaticResource SubtleButtonStyle}"
            TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <DataTemplate x:Key="AccountItemActionsTemplate" x:DataType="models:Account">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button
                    x:Name="AccountItemEditButton"
                    AutomationProperties.Name="계정 수정"
                    Click="AccountItem_Edit_Click"
                    DoubleTapped="AccountItemButton_DoubleTapped"
                    Style="{StaticResource AccountItemActionButtonStyle}"
                    Tag="{x:Bind}"
                    ToolTipService.ToolTip="수정">
                    <FontIcon FontSize="{Binding FontSize, ElementName=AccountItemEditButton}" Glyph="&#xE70F;" />
                </Button>
                <Button
                    x:Name="AccountItemDeleteButton"
                    AutomationProperties.Name="계정 삭제"
                    Click="AccountItem_Delete_Click"
                    DoubleTapped="AccountItemButton_DoubleTapped"
                    Style="{StaticResource AccountItemActionButtonStyle}"
                    Tag="{x:Bind}"
                    ToolTipService.ToolTip="삭제">
                    <FontIcon FontSize="{Binding FontSize, ElementName=AccountItemDeleteButton}" Glyph="&#xE74D;" />
                </Button>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="AccountListViewTemplate" x:DataType="models:Account">
            <Grid Margin="12,4" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    Text="{x:Bind local:AccountSettingPage.GetAccountDisplayText(Id, Nickname)}"
                    TextTrimming="CharacterEllipsis" />
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="4">
                    <Button
                        x:Name="AccountItemUpButton"
                        CommandParameter="-1"
                        Loaded="ReorderButton_Loaded"
                        Unloaded="ReorderButton_Unloaded"
                        AutomationProperties.Name="계정 위로 이동"
                        Click="AccountItem_MoveUp_Click"
                        DoubleTapped="AccountItemButton_DoubleTapped"
                        Style="{StaticResource AccountItemActionButtonStyle}"
                        Tag="{x:Bind}"
                        ToolTipService.ToolTip="위로 이동">
                        <FontIcon FontSize="{Binding FontSize, ElementName=AccountItemUpButton}" Glyph="&#xE70E;" />
                    </Button>
                    <Button
                        x:Name="AccountItemDownButton"
                        CommandParameter="1"
                        Loaded="ReorderButton_Loaded"
                        Unloaded="ReorderButton_Unloaded"
                        AutomationProperties.Name="계정 아래로 이동"
                        Click="AccountItem_MoveDown_Click"
                        DoubleTapped="AccountItemButton_DoubleTapped"
                        Style="{StaticResource AccountItemActionButtonStyle}"
                        Tag="{x:Bind}"
                        ToolTipService.ToolTip="아래로 이동">
                        <FontIcon FontSize="{Binding FontSize, ElementName=AccountItemDownButton}" Glyph="&#xE70D;" />
                    </Button>
                    <ContentPresenter Content="{x:Bind}" ContentTemplate="{StaticResource AccountItemActionsTemplate}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid x:Name="AccountPageRoot">
        <Grid Padding="24" HorizontalAlignment="Stretch">
            <Grid
                MaxWidth="896"
                HorizontalAlignment="Stretch"
                RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="계정 설정" />
                <Grid
                    x:Name="AccountCardViewport"
                    Grid.Row="1"
                    Loaded="AccountCardViewport_Loaded"
                    SizeChanged="AccountCardViewport_SizeChanged">
                    <toolkit:SettingsCard
                        x:Name="AccountSettingsCard"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        ContentAlignment="Vertical">
                        <Grid
                            x:Name="AccountCardContent"
                            Height="0"
                            RowSpacing="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <RadioButtons
                                HorizontalAlignment="Left"
                                AutomationProperties.AutomationId="AccountListDisplayMode"
                                AutomationProperties.Name="계정 표시 방식"
                                Header="계정 표시 방식"
                                IsEnabled="{x:Bind AccountManagementEnabled, Mode=OneWay}"
                                MaxColumns="2"
                                SelectedIndex="{x:Bind AccountListDisplayModeIndex, Mode=TwoWay}">
                                <x:String>그룹으로 보기</x:String>
                                <x:String>순서대로 보기</x:String>
                            </RadioButtons>
                            <StackPanel
                                Grid.Row="1"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="8">
                                <Button
                                    x:Name="Button_Add"
                                    AutomationProperties.AutomationId="AddAccount"
                                    Click="Button_Add_Click"
                                    Content="추가"
                                    IsEnabled="{x:Bind AccountManagementEnabled, Mode=OneWay}"
                                    Style="{StaticResource AccentButtonStyle}" />
                                <Button
                                    x:Name="Button_Edit"
                                    AutomationProperties.AutomationId="EditAccount"
                                    Click="Button_Edit_Click"
                                    Content="수정"
                                    IsEnabled="{x:Bind CanEditSelectedAccount, Mode=OneWay}" />
                                <Button
                                    x:Name="Button_Delete"
                                    AutomationProperties.AutomationId="DeleteAccount"
                                    Click="Button_Delete_Click"
                                    Content="삭제"
                                    IsEnabled="{x:Bind CanDeleteSelectedAccount, Mode=OneWay}" />
                            </StackPanel>
                            <Border
                                Grid.Row="2"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{ThemeResource ControlCornerRadius}">
                                <Grid>
                                    <ListView
                                        x:Name="AccountListView"
                                        AutomationProperties.AutomationId="GroupedAccountList"
                                        Background="Transparent"
                                        ContextRequested="AccountList_ContextRequested"
                                        DoubleTapped="AccountList_DoubleTapped"
                                        IsEnabled="{x:Bind AccountManagementEnabled, Mode=OneWay}"
                                        ItemContainerStyle="{StaticResource AccountItemContainerStyle}"
                                        ItemTemplate="{StaticResource AccountListViewTemplate}"
                                        IsMultiSelectCheckBoxEnabled="True"
                                        ItemsSource="{x:Bind AccountsCVS.View, Mode=OneWay}"
                                        SelectionChanged="AccountListView_SelectionChanged"
                                        SelectionMode="Multiple"
                                        Visibility="{x:Bind GroupedListVisibility, Mode=OneWay}">
                                        <ListView.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <ItemsStackPanel AreStickyGroupHeadersEnabled="True" />
                                            </ItemsPanelTemplate>
                                        </ListView.ItemsPanel>
                                        <ListView.GroupStyle>
                                            <GroupStyle HeaderContainerStyle="{StaticResource AccountGroupHeaderContainerStyle}">
                                                <GroupStyle.HeaderTemplate>
                                                    <DataTemplate x:DataType="models:AccountGroupInfoList">
                                                        <Grid ColumnSpacing="12">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock
                                                                VerticalAlignment="Center"
                                                                AutomationProperties.AccessibilityView="Raw"
                                                                Style="{ThemeResource SubtitleTextBlockStyle}"
                                                                Text="{x:Bind Key}" TextTrimming="CharacterEllipsis" />
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                                                <Button x:Name="AccountGroupUpButton"
                                                                        CommandParameter="-1" Loaded="ReorderButton_Loaded" Unloaded="ReorderButton_Unloaded"
                                                                        Style="{StaticResource AccountItemActionButtonStyle}"
                                                                        AutomationProperties.Name="그룹 위로 이동" ToolTipService.ToolTip="그룹 위로 이동"
                                                                        Click="AccountGroup_MoveUp_Click" Tag="{x:Bind}">
                                                                    <FontIcon FontSize="{Binding FontSize, ElementName=AccountGroupUpButton}" Glyph="&#xE70E;" />
                                                                </Button>
                                                                <Button x:Name="AccountGroupDownButton"
                                                                        CommandParameter="1" Loaded="ReorderButton_Loaded" Unloaded="ReorderButton_Unloaded"
                                                                        Style="{StaticResource AccountItemActionButtonStyle}"
                                                                        AutomationProperties.Name="그룹 아래로 이동" ToolTipService.ToolTip="그룹 아래로 이동"
                                                                        Click="AccountGroup_MoveDown_Click" Tag="{x:Bind}">
                                                                    <FontIcon FontSize="{Binding FontSize, ElementName=AccountGroupDownButton}" Glyph="&#xE70D;" />
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </GroupStyle.HeaderTemplate>
                                            </GroupStyle>
                                        </ListView.GroupStyle>
                                    </ListView>
                                    <ListView
                                        x:Name="OrderedAccountListView"
                                        AllowDrop="True"
                                        AutomationProperties.AutomationId="OrderedAccountList"
                                        Background="Transparent"
                                        CanDragItems="True"
                                        CanReorderItems="True"
                                        IsMultiSelectCheckBoxEnabled="True"
                                        ContextRequested="AccountList_ContextRequested"
                                        DoubleTapped="AccountList_DoubleTapped"
                                        DragItemsCompleted="OrderedAccountListView_DragItemsCompleted"
                                        IsEnabled="{x:Bind AccountManagementEnabled, Mode=OneWay}"
                                        ItemContainerStyle="{StaticResource AccountItemContainerStyle}"
                                        ItemTemplate="{StaticResource AccountListViewTemplate}"
                                        ItemsSource="{x:Bind OrderedAccounts, Mode=OneWay}"
                                        SelectionChanged="OrderedAccountListView_SelectionChanged"
                                        SelectionMode="Multiple"
                                        Visibility="{x:Bind OrderedListVisibility, Mode=OneWay}" />
                                </Grid>
                            </Border>
                        </Grid>
                    </toolkit:SettingsCard>
                </Grid>
            </Grid>
        </Grid>

        <drawer:Drawer
            x:Name="AccountEditorDrawer"
            AutomationProperties.AutomationId="AccountEditorDrawer"
            AutomationProperties.Name="{x:Bind EditorTitle, Mode=OneWay}"
            Closed="AccountEditorDrawer_Closed"
            Closing="AccountEditorDrawer_Closing"
            InteractionFailed="AccountEditorDrawer_InteractionFailed"
            Modal="True"
            Opened="AccountEditorDrawer_Opened"
            PanelLength="480"
            Placement="Right">
            <Grid RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="{x:Bind EditorTitle, Mode=OneWay}" />
                <ScrollViewer
                    Grid.Row="1"
                    HorizontalScrollBarVisibility="Disabled"
                    HorizontalScrollMode="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    VerticalScrollMode="Auto">
                    <ContentControl
                        HorizontalContentAlignment="Stretch"
                        IsEnabled="{x:Bind EditorInputsEnabled, Mode=OneWay}"
                        IsTabStop="False">
                        <StackPanel Spacing="12">
                            <TextBox
                                x:Name="TextBox_Id"
                                AutomationProperties.AutomationId="AccountEditorId"
                                Header="아이디"
                                KeyDown="EditorInput_KeyDown"
                                PlaceholderText="게임 아이디"
                                TabIndex="0"
                                Text="{x:Bind Editor.Id, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <StackPanel Spacing="8">
                                <CheckBox
                                    x:Name="CheckBox_ChangePassword"
                                    AutomationProperties.AutomationId="AccountEditorChangePassword"
                                    Click="CheckBox_ChangePassword_Click"
                                    Content="패스워드도 변경"
                                    IsChecked="{x:Bind Editor.IsChangingPassword, Mode=OneWay}"
                                    Visibility="{x:Bind ChangePasswordToggleVisibility, Mode=OneWay}" />
                                <PasswordBox
                                    x:Name="PasswordBox_Pwd"
                                    AutomationProperties.AutomationId="AccountEditorPassword"
                                    Header="{x:Bind PasswordBoxHeader, Mode=OneWay}"
                                    KeyDown="EditorInput_KeyDown"
                                    PasswordChanged="PasswordBox_Pwd_PasswordChanged"
                                    PlaceholderText="{x:Bind PasswordPlaceholderText, Mode=OneWay}"
                                    TabIndex="1"
                                    Visibility="{x:Bind PasswordBoxVisibility, Mode=OneWay}" />
                            </StackPanel>
                            <TextBox
                                x:Name="TextBox_Nickname"
                                AutomationProperties.AutomationId="AccountEditorNickname"
                                Header="(선택) 닉네임"
                                KeyDown="EditorInput_KeyDown"
                                PlaceholderText="예시) 상재, 장사, 생시, etc..."
                                TabIndex="2"
                                Text="{x:Bind Editor.Nickname, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox
                                x:Name="TextBox_GroupName"
                                AutomationProperties.AutomationId="AccountEditorGroupName"
                                Header="(선택) 그룹 이름"
                                KeyDown="EditorInput_KeyDown"
                                PlaceholderText="예시) 나, 동생, 1, 2, 3, etc..."
                                TabIndex="3"
                                Text="{x:Bind Editor.GroupName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <RichTextBlock FontStyle="Italic">
                                <Paragraph>본 프로그램은 비밀번호를 Windows 자격 증명 관리자를 통해 로컬에 저장하며, 운영체제의 보안 메커니즘에 의해 보호됩니다.</Paragraph>
                                <Paragraph>또한, 계정 정보를 로컬을 제외한 개발자 서버 또는 제3자에게 별도로 제공 및 저장하지 않습니다.</Paragraph>
                                <Paragraph>예외로 자동 로그인을 위해 아이디 및 비밀번호가 거상 공식 홈페이지를 통해 전송될 수 있습니다.</Paragraph>
                                <Paragraph>
                                    <Hyperlink Click="PrivacyPolicyHyperlink_Click">개인정보취급방침</Hyperlink>
                                    을 통해 자세한 정보를 확인하실 수 있습니다.</Paragraph>
                            </RichTextBlock>
                        </StackPanel>
                    </ContentControl>
                </ScrollViewer>
                <StackPanel
                    Grid.Row="2"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Name="Button_Save"
                        AutomationProperties.AutomationId="SaveAccount"
                        Click="Button_Save_Click"
                        Content="{x:Bind SaveButtonText, Mode=OneWay}"
                        IsEnabled="{x:Bind CanSave, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}"
                        TabIndex="4" />
                    <Button
                        x:Name="Button_Reset"
                        AutomationProperties.AutomationId="ResetAccountEditor"
                        Click="Button_Reset_Click"
                        Content="입력 초기화"
                        IsEnabled="{x:Bind EditorInputsEnabled, Mode=OneWay}"
                        Visibility="{x:Bind ResetButtonVisibility, Mode=OneWay}" />
                    <Button
                        x:Name="Button_CancelEdit"
                        AutomationProperties.AutomationId="CancelAccountEditor"
                        Click="Button_CancelEdit_Click"
                        Content="취소"
                        IsEnabled="{x:Bind EditorInputsEnabled, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </drawer:Drawer>
    </Grid>
</Page>
