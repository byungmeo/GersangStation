<?xml version="1.0" encoding="utf-8" ?>
<Application
    x:Class="GersangStation.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GersangStation">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!--  Other merged dictionaries here  -->
            </ResourceDictionary.MergedDictionaries>
            <FontFamily x:Key="AppFontFamily">ms-appx:///Assets/Fonts/NotoSansKR-VariableFont_wght.ttf#Noto Sans KR</FontFamily>
            <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/NotoSansKR-VariableFont_wght.ttf#Noto Sans KR</FontFamily>
            <FontFamily x:Key="TextControlThemeFontFamily">ms-appx:///Assets/Fonts/NotoSansKR-VariableFont_wght.ttf#Noto Sans KR</FontFamily>
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
