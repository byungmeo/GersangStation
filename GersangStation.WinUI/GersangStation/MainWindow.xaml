<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="GersangStation.Main.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GersangStation.Controls"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    Title="거상스테이션(GersangStation)">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition
                Width="288"
                MinWidth="288"
                MaxWidth="512" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <controls:SidebarView
            x:Name="Sidebar"
            Grid.Column="0"
            BrowserLoginRequested="Sidebar_BrowserLoginRequested"
            BrowserRequested="Sidebar_BrowserRequested"
            HomeRequested="Sidebar_HomeRequested"
            SettingRequested="Sidebar_SettingRequested" />

        <toolkit:GridSplitter
            Grid.Column="1"
            HorizontalAlignment="Stretch"
            CornerRadius="4"
            IsThumbVisible="False"
            ResizeBehavior="PreviousAndNext"
            ResizeDirection="Columns" />

        <Grid
            x:Name="ShellContentHost"
            Grid.Column="2"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            CornerRadius="16,0,0,0"
            Translation="0,0,8">
            <Grid.Shadow>
                <ThemeShadow />
            </Grid.Shadow>
            <Frame x:Name="StationFrame" IsNavigationStackEnabled="False" />
            <Grid x:Name="BrowserSurface" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Frame x:Name="BrowserFrame" IsNavigationStackEnabled="False" />
                <WebView2 x:Name="BrowserWebView" Grid.Row="1" />
            </Grid>
            <Frame
                x:Name="SettingFrame"
                IsNavigationStackEnabled="False"
                Visibility="Collapsed" />
        </Grid>

        <TeachingTip
            x:Name="StoreUpdateTeachingTip"
            Grid.Column="2"
            ActionButtonClick="StoreUpdateTeachingTip_ActionButtonClick"
            CloseButtonContent="닫기"
            IsLightDismissEnabled="True"
            PreferredPlacement="Top"
            Target="{x:Bind Sidebar.CurrentAppVersionTarget}" />
    </Grid>
</Window>
