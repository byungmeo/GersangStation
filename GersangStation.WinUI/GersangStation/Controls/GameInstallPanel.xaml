<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="GersangStation.Controls.GameInstallPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Frame x:Name="ClientSettingsFrame" IsNavigationStackEnabled="False" />
        <Grid
            Grid.Row="1"
            Margin="0,12,0,0"
            HorizontalAlignment="Stretch"
            RowSpacing="8"
            Visibility="{x:Bind State.InstallProgressVisibility, Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressBar
                    Height="8"
                    VerticalAlignment="Center"
                    Maximum="{x:Bind State.ProgressMaximum, Mode=OneWay}"
                    Value="{x:Bind State.ProgressValue, Mode=OneWay}" />
                <Button
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="게임 설치 취소"
                    Click="Cancel_Click"
                    IsEnabled="{x:Bind State.IsDownloading, Mode=OneWay}"
                    Style="{ThemeResource AlternateCloseButtonStyle}"
                    ToolTipService.ToolTip="설치 취소"
                    Visibility="{x:Bind State.InstallCancelVisibility, Mode=OneWay}">
                    <FontIcon Glyph="&#xE711;" />
                </Button>
            </Grid>
            <TextBlock
                Grid.Row="1"
                HorizontalAlignment="Center"
                Text="{x:Bind State.ProgressText, Mode=OneWay}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </Grid>
    </Grid>
</UserControl>
